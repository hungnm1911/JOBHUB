{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "test:auth": "node test/authentication/authentication-interceptors.test.js && node test/authentication/authentication-manager.test.js && node test/authentication/account-context-loader.test.js && node test/authentication/role-route.test.js && node test/authentication/job-discovery-route.test.js",
    "test:job-cards": "node --test test/job-card-navigation.test.js",
    "test:candidate-header-ai-actions": "node --test test/candidate-header-ai-actions.test.js",
    "test:featured-homepage": "node --test test/featured-homepage.test.js",
    "test:recruiter-home": "node --test --test-concurrency=1 test/recruiter-home.test.js test/recruiter-website-flow.test.js",
    "test:company-manager": "node --test --test-concurrency=1 test/company-manager-workspace.test.js",
    "test:rich-text": "node --test --test-concurrency=1 test/rich-text-editor.test.js test/rich-text-viewer.test.js test/rich-text-preview.test.js test/company-rich-text-integration.test.js test/job-rich-text-integration.test.js",
    "test:candidate-cvs": "node --test --test-concurrency=1 test/candidate-cv-builder.test.js test/candidate-cv-management.test.js test/candidate-cv-rich-text.test.js",
    "test:unsaved-changes": "node --test test/unsaved-changes.test.js",
    "test:cv-optimization-proposal": "node --test --test-concurrency=1 test/candidate-cv-optimization-proposal.test.js test/candidate-cv-optimization-diff.test.js test/candidate-cv-optimization-workspace.test.js test/candidate-cv-optimization-legacy-migration.test.js",
    "test:ai-timeouts": "node --test test/candidate-job-recommendation-timeout.test.js test/candidate-cv-evaluation-timeout.test.js",
    "preview": "vite preview",
    "verify:agent": "yarn test:auth && yarn test:job-cards && yarn test:candidate-header-ai-actions && yarn test:featured-homepage && yarn test:recruiter-home && yarn test:company-manager && yarn test:rich-text && yarn test:candidate-cvs && yarn test:unsaved-changes && yarn test:cv-optimization-proposal && yarn test:ai-timeouts && yarn lint && yarn build"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-slot": "^1.4.0",
    "@reduxjs/toolkit": "^2.13.0",
    "@tiptap/core": "^3.32.2",
    "@tiptap/extension-highlight": "3.32.2",
    "@tiptap/extension-text-align": "3.32.2",
    "@tiptap/extension-text-style": "3.32.2",
    "@tiptap/extensions": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.17",
    "lucide-react": "^1.54.0",
    "react": "^19.2.8",
    "react-diff-viewer-continued": "^4.4.0",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.89.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.4",
    "socket.io-client": "^4.8.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.2.0"
  }
}
